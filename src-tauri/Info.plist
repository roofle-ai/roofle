<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Menu-bar-only app (S14): hides the Dock icon; Roofle lives in the menu
	     bar and shows its popup window on demand. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Microphone permission (S3/S9): required before cpal can open an input
	     stream. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Roofle uses the microphone to transcribe your speech in real time.</string>
	<!-- Screen Recording permission (S11): a separate TCC category from the
	     microphone, required even for audio-only SCStream capture. -->
	<key>NSScreenCaptureUsageDescription</key>
	<string>Roofle captures system audio to transcribe what is playing on your Mac.</string>
	<!-- Downloads access: exports (notes, transcript) are saved to ~/Downloads. -->
	<key>NSDownloadsFolderUsageDescription</key>
	<string>Roofle saves exported notes and transcripts to your Downloads folder.</string>
</dict>
</plist>
