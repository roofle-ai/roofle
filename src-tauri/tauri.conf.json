{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Roofle",
  "mainBinaryName": "Roofle",
  "version": "1.0.0-beta",
  "identifier": "com.roofle.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Roofle",
        "visible": false,
        "transparent": true,
        "width": 980,
        "height": 680,
        "minWidth": 560,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist",
      "entitlements": "entitlements.plist"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4Njg5NkZGOEIxMTJGQ0UKUldUT0x4R0wvNVpvYU5nbVd5N21LRXVBN0crR2J0NU1MT3RES0VmOUs1aDNrWitJemp0MlNUaDEK",
      "endpoints": [
        "https://github.com/roofle-ai/roofle/releases/latest/download/latest.json"
      ]
    }
  }
}
